# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=inubot

# Ceremony page (HTTPS in production; WebAuthn RP ID is the hostname)
CEREMONY_URL=http://localhost:5173
CEREMONY_RP_ID=localhost
CEREMONY_SECRET=replace-with-64-hex-or-long-random-string

# Alchemy (Robinhood Chain, 4663)
ALCHEMY_API_KEY=
ALCHEMY_GAS_POLICY_ID=

# Session-key encryption: 32-byte key as 64 hex chars
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY_SECRET=

# Postgres
DATABASE_URL=postgresql://inubot:inubot@localhost:5432/inubot

# Optional
PORT=3000
PUBLIC_API_URL=http://localhost:3000
