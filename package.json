{
  "name": "inubot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @inubot/bot --filter @inubot/ceremony dev",
    "dev:bot": "pnpm --filter @inubot/bot dev",
    "dev:ceremony": "pnpm --filter @inubot/ceremony dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @inubot/db generate",
    "db:migrate": "pnpm --filter @inubot/db migrate",
    "db:push": "pnpm --filter @inubot/db push",
    "smoke": "pnpm --filter @inubot/route smoke"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
